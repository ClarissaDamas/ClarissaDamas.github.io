---
import type { Locale } from '../i18n/ui';

type SkillsData = typeof import('../data/skills.json');

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  skills: SkillsData;
}

const { locale, eyebrow, title, skills } = Astro.props;
---

<section class="section section--muted" id="skills">
  <div class="container">
    <div class="text-center section-heading">
      <p class="section-eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="d-flex flex-wrap justify-content-center gap-2">
      {skills.items.map((skill) => <span class="skill-pill">{skill}</span>)}
    </div>
    <div class="row justify-content-center g-0 stats mt-5">
      {skills.stats.map((stat) => (
        <div class="col-md-6 text-center p-4">
          <p class="stats__value mb-1">{stat.value}</p>
          <p class="text-secondary text-uppercase small mb-0">{stat.label[locale]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
