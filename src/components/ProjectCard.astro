---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
  image: ImageMetadata;
  viewLabel: string;
}

const { locale, project, image, viewLabel } = Astro.props;
---

<article class="card project-card h-100 border-0">
  <Image class="card-img-top project-card__image" src={image} alt={project.data.title[locale]} widths={[500, 720]} sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 33vw" />
  <div class="card-body d-flex flex-column p-4">
    <h3 class="h5 card-title">{project.data.title[locale]}</h3>
    <div class="d-flex flex-wrap gap-2 mb-3">
      {project.data.tech.map((technology) => <span class="badge rounded-pill text-bg-primary">{technology}</span>)}
    </div>
    <p class="card-text text-secondary flex-grow-1">{project.data.description[locale]}</p>
    <a class="btn btn-outline-primary mt-3 w-100" href={project.data.link} target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-github me-2" aria-hidden="true"></i>{viewLabel}
    </a>
  </div>
</article>
